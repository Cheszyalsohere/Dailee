# Salin ke file .env lokal, lalu isi kunci Gemini dari Google AI Studio.
GEMINI_API_KEY = 
GEMINI_MODEL = gemini-3.8-flash

# Enables simulated provider buttons only when CI_ENVIRONMENT is development.
DEMO_LOGIN_ENABLED = false

# --- Production (Hostinger) ---
CI_ENVIRONMENT = production
app.baseURL = 'https://domainmu.com/'
app.indexPage = ''
app.forceGlobalSecureRequests = true

database.default.hostname = localhost
database.default.database = 
database.default.username = 
database.default.password = 
database.default.DBDriver = MySQLi
database.default.port = 3306

# Akun admin awal untuk `php spark db:seed AdminSeeder`.
# Kalau ADMIN_PASSWORD kosong, seeder membuat password acak dan menampilkannya sekali.
ADMIN_USERNAME = admin
ADMIN_EMAIL = admin@dailee.web.id
ADMIN_PASSWORD = 
